# SymbiYosys BMC: pipelined datapath == combinational reference (mul_bf16).
# See formal/fp_pipe_equiv.sv (the add files are read too: yosys elaborates
# the default-parameter fp_pipe_equiv as well). Run via:  sby -f bmc_equiv_mul_bf16.sby

[tasks]
bmc

[options]
mode bmc
depth 6
expect pass

[engines]
smtbmc bitwuzla

[script]
read_verilog -sv -formal jsm_fp_pkg.sv
read_verilog -sv -formal jsm_fp_add.sv
read_verilog -sv -formal jsm_fp_add_pipe.sv
read_verilog -sv -formal jsm_fp_mul.sv
read_verilog -sv -formal jsm_fp_mul_core.sv
read_verilog -sv -formal jsm_fp_mul_pipe.sv
read_verilog -sv -formal fp_pipe_equiv.sv
prep -top fp_pipe_equiv_mul_bf16

[files]
rtl/jsm_fp_pkg.sv
rtl/jsm_fp_add.sv
rtl/jsm_fp_add_pipe.sv
rtl/jsm_fp_mul.sv
rtl/jsm_fp_mul_core.sv
rtl/jsm_fp_mul_pipe.sv
formal/fp_pipe_equiv.sv
